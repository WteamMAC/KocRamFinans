generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  username    String?  @unique
  email       String?  @unique
  role        String   @default("USER")
  isBanned    Boolean  @default(false)
  familyCount Int      @default(1)
  
  maritalStatus String?
  marriageDate  DateTime?
  hasChildren   Boolean   @default(false)
  children      Child[]

  incomes     Income[]
  expenses    Expense[]
  debts       Debt[]
  investments Investment[]
  fixedAssets FixedAsset[]

  // Blog ilişkileri
  blogPosts    BlogPost[]    @relation("BlogPosts")
  blogLikes    BlogLike[]    @relation("BlogLikes")
  blogComments BlogComment[] @relation("BlogComments")
  
  // Takipçi Sistemi
  followers    Follow[] @relation("following")
  following    Follow[] @relation("follower")

  // Topluluk İlişkileri
  createdCommunities Community[] @relation("CreatedCommunities")
  communities        CommunityMember[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FixedAsset {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   // e.g., "Araba", "Ev", "Telefon"
  type        String   // Category: "Vehicle", "RealEstate", "Electronics", "Other"
  value       Float    // Estimated value
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Child {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Income {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String   // "Salary", "SpouseSalary", "Rent", "Freelance", "Other"
  amount          Float
  date            DateTime @default(now())
  dueDate         Int?     // Day of the month (1-31)
  isRecurring     Boolean  @default(true)
  description     String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Expense {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String   // "Rent", "Bill", "Groceries", "Transport", "Other"
  amount          Float
  date            DateTime @default(now())
  dueDate         Int?     // Day of the month (1-31)
  isRecurring     Boolean  @default(true)
  description     String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Debt {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  String   // "CreditCard", "BankLoan", "Personal", "Other"
  amount                Float
  remainingInstallments Int?     // Number of months left
  description           String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Investment {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String   // "Gold", "Crypto", "Stock", "RealEstate", "ForeignCurrency", "BIST", "NASDAQ", "CRYPTO"
  symbol           String?  // Ticker symbol (e.g., "BTC", "THYAO", "TSLA")
  quantity         Float    @default(1)
  purchasePrice    Float?   // Alış birim fiyatı
  amount           Float    // Toplam alış tutarı (quantity * purchasePrice)
  currentValuation Float?   // Güncel toplam değer (quantity * currentPrice)
  description      String?
  
  // İşlem Durumu
  status           String   @default("OPEN")    // "OPEN" | "CLOSED"
  transactionType  String   @default("BUY")     // "BUY" | "SELL"
  soldPrice        Float?   // Satış birim fiyatı
  soldAt           DateTime? // Satış tarihi

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================
// BLOG MODÜLÜ
// ============================================================

model BlogPost {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("BlogPosts", fields: [authorId], references: [id], onDelete: Cascade)

  content   String
  imageUrl  String?
  tags           String[]
  isAnnouncement Boolean  @default(false)

  // Topluluk İlişkisi
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id])

  likes     BlogLike[]
  comments  BlogComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogLike {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("BlogLikes", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}


model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("BlogComments", fields: [authorId], references: [id], onDelete: Cascade)

  content   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String   // Takip eden kullanıcı
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String   // Takip edilen kullanıcı
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Community {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String?
  isPrivate   Boolean  @default(false)
  tags        String[] // ["altın", "kripto", "bes", "faiz", "ekonomi", "genel"]
  
  creatorId   String
  creator     User     @relation("CreatedCommunities", fields: [creatorId], references: [id])
  
  members     CommunityMember[]
  posts       BlogPost[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model CommunityMember {
  id          String   @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER") // "ADMIN", "MODERATOR", "MEMBER"
  status      String    @default("ACCEPTED") // "ACCEPTED", "PENDING", "REJECTED"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([communityId, userId])
}
